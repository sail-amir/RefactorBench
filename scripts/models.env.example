# Copy this file to scripts/models.env (gitignored) and fill in your values.
# scripts/run_model.py auto-loads scripts/models.env before each run.
# Lines are KEY=VALUE (optional leading `export`); quotes are stripped.

# --- Shared OpenAI-compatible gateway ---------------------------------------
# All models hit the SAME endpoint + key; only the model name differs.
RB_API_BASE=https://your-gateway/v1     # base URL ending before /chat/completions
RB_API_KEY=your-gateway-token

# --- Per-model names as exposed by your gateway -----------------------------
# Keep the litellm "openai/" prefix; everything after it is the gateway's name.
CLAUDE_MODEL=openai/claude-opus-4-8
DEEPSEEK_MODEL=openai/deepseek-chat
GLM_MODEL=openai/glm-5.1
PANGU_MODEL=openai/pangu_auto

# --- Optional overrides -----------------------------------------------------
# If one model needs a different URL/key than the shared gateway:
#   CLAUDE_API_BASE=...   CLAUDE_API_KEY=...   (same for DEEPSEEK_/GLM_/PANGU_)
# Force one action parser for ALL models (else: claude/deepseek=function_calling,
# glm/pangu=thought_action). Use thought_action if the gateway doesn't pass
# native tool-calls through:
#   RB_PARSE=thought_action
